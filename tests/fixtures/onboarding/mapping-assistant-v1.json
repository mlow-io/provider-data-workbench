{
  "version": 1,
  "designation": "independently authored synthetic mapping holdout; no real clinicians",
  "cases": [
    {
      "id": "canonical",
      "headers": [
        "record_id",
        "npi",
        "provider_name",
        "address",
        "city",
        "state",
        "zip",
        "phone",
        "location_id"
      ],
      "rows": [
        {
          "record_id": "SYN-001",
          "npi": "1000000001",
          "provider_name": "Synthetic Clinician",
          "address": "10 Example St",
          "city": "Example",
          "state": "MA",
          "zip": "02108",
          "phone": "6175550100",
          "location_id": "NORTH"
        }
      ],
      "expected_mapping": {
        "record_id": "record_id",
        "npi": "npi",
        "provider_name": "provider_name",
        "address": "address",
        "city": "city",
        "state": "state",
        "zip": "zip",
        "phone": "phone",
        "location_id": "location_id"
      },
      "expected_cleaned": [
        {
          "phone": "6175550100",
          "zip": "02108"
        }
      ],
      "gold_operations": {}
    },
    {
