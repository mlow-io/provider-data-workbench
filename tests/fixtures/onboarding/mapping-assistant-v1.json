          "state": "MA",
          "provider_name": "Synthetic Clinician"
        }
      ],
      "gold_operations": {
        "phone": [
          "phone_us"
        ],
        "zip": [
          "zip_us"
        ],
        "state": [
          "state_us"
        ],
        "provider_name": [
          "trim",
          "collapse_spaces"
        ]
      }
    },
